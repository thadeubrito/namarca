{
  "name": "namarca",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @namarca/admin --",
    "build:event": "npm run build:campaign",
    "dev:event": "npm run dev --workspace @namarca/campaign",
    "build": "npm run build --workspace @namarca/admin",
    "start": "npm run start --workspace @namarca/admin --",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts services/pixgo-mock/server.test.mjs",
    "db:generate": "npm run db:generate --workspace @namarca/admin",
    "db:migrate": "npm run db:migrate --workspace @namarca/admin",
    "db:push": "npm run db:push --workspace @namarca/admin",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "dev:env": "node scripts/dev-env.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:webhook": "tsx scripts/test-webhook.ts",
    "test:checkout": "tsx scripts/test-checkout.ts",
    "build:campaign": "npm run build --workspace @namarca/campaign"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "0.27.4",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0"
  }
}
