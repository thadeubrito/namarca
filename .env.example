# Documentation only. Generate .env.local using scripts/dev-env.mjs; no production defaults.
POSTGRES_USER=namarca
POSTGRES_DB=namarca
POSTGRES_PASSWORD=
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ADMIN_EMAIL=admin@namarca.test
S3_ENDPOINT=http://s3:9000
# Optional browser-reachable endpoint for signed uploads (local: http://localhost:9000); HTTPS required in production. Falls back to S3_ENDPOINT.
# S3_UPLOAD_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=namarca-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
PIXGO_MODE=mock
PIXGO_BASE_URL=http://pixgo-mock:4010/api/v1
PIXGO_API_KEY=
PIXGO_WEBHOOK_SECRET=
PIXGO_WEBHOOK_URL=http://app:3000/api/webhooks/pixgo
PIXGO_MOCK_DEV_TOKEN=
