{
  "name": "@namarca/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:preview",
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build:preview": "npm run build --workspace @namarca/campaign && node scripts/copy-preview.mjs",
    "prebuild": "npm run build:preview",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
